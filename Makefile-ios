CGO_ENABLED ?= 1
GOOS        ?= ios
GOARCH      ?= arm64
GOMINIOS    ?= 14.0
TARGET      ?= gh
SIGN_TOOL   ?= ldid
BUILD_DIR   ?= ./cmd/gh
SDKROOT     ?= $(shell xcrun --sdk iphoneos --show-sdk-path)

.PHONY: all
all: deps $(TARGET)

.PHONY: deps
deps:
	go mod tidy
	go mod vendor

$(TARGET):
	CGO_ENABLED=$(CGO_ENABLED) GOOS=$(GOOS) GOARCH=$(GOARCH) SDKROOT=$(SDKROOT) go build -o $@ $(BUILD_DIR)
	$(SIGN_TOOL) -S $@

.PHONY: clean
clean:
	rm -f $(TARGET)

.PHONY: lint
lint:
	golangci-lint run ./...

.PHONY: test
	test:
	go test ./...
