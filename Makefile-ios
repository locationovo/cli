CGO_ENABLED ?= 0
GOOS        ?= ios
GOARCH      ?= arm64
TARGET      ?= gh
SIGN_TOOL   ?= ldid
BUILD_DIR   ?= ./cmd/gh

.PHONY: all
all: deps $(TARGET)

.PHONY: deps
deps:
	go mod tidy

$(TARGET):
	CGO_ENABLED=$(CGO_ENABLED) GOOS=$(GOOS) GOARCH=$(GOARCH) go build -o $@ $(BUILD_DIR)
	$(SIGN_TOOL) -S $@

.PHONY: clean
clean:
	rm -f $(TARGET)

.PHONY: lint
lint:
	golangci-lint run ./...

.PHONY: test
test:
	go test ./...
